# Landline Backend — Environment Variables
# Copy to .env (development) or .env.production (staging/prod)

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://landline:CHANGE_ME@localhost:5432/landline_db
POSTGRES_USER=landline
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=landline_db

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- AWS (SES — fallback email transport when no Gmail account is connected) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_SENDER_EMAIL=landline@apprendtechnologies.com

# ---- Google / Gmail OAuth (per-user email sending) ----
# Create an OAuth client in Google Cloud Console — see deploy/GOOGLE-OAUTH-SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an Authorized redirect URI in the Google OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=https://landline-api.apprendtechnologies.com/api/v1/gmail/oauth/callback
# Frontend origin the OAuth popup posts back to (and is allowed to receive the result).
FRONTEND_URL=https://landline.apprendtechnologies.com
# Fernet key used to encrypt stored OAuth tokens at rest. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Claude API (scoring + email generation) ----
ANTHROPIC_API_KEY=

# ---- Apollo.io (contact enrichment) ----
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io/v1

# ---- Census Bureau (market data) ----
CENSUS_API_KEY=

# ---- Auth / security ----
# REQUIRED. Secret used to sign JWT access/refresh tokens. The app refuses to
# boot without one (no insecure default). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Optional shared API key. When set, requests may authenticate with the
# X-API-Key header instead of a JWT. Auth is mandatory either way.
API_KEY=
# Optional Redis URI for shared rate-limit counters across workers
# (defaults to in-process memory). e.g. redis://localhost:6379/2
RATELIMIT_STORAGE_URI=

# ---- App ----
APP_NAME=Landline
# Set to "production" to disable interactive /docs, /redoc, and /openapi.json.
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ---- CORS ----
# JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
