# Landline Backend — Environment Variables
# Copy to .env (development) or .env.production (staging/prod)

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://landline:CHANGE_ME@localhost:5432/landline_db
POSTGRES_USER=landline
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=landline_db

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- AWS (SES — fallback email transport when no Gmail account is connected) ----
# SES sends from its own DNS-verified domain, so keep this on the SES-verified
# identity. The PRIMARY sender is the connected apprend.tech Gmail account below.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_SENDER_EMAIL=landline@apprendtechnologies.com

# Canonical primary sender. Outreach is sent through the connected Gmail OAuth
# account whose address matches this (Google Workspace DKIM-signs automatically).
# Also the domain the deliverability/test-send endpoints check before OAuth is wired.
PRIMARY_SENDER_EMAIL=suman.das@apprend.tech

# ---- Google / Gmail OAuth (per-user email sending) ----
# Create an OAuth client in Google Cloud Console — see deploy/GOOGLE-OAUTH-SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an Authorized redirect URI in the Google OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=https://landline-api.apprendtechnologies.com/api/v1/gmail/oauth/callback
# Frontend origin the OAuth popup posts back to (and is allowed to receive the result).
FRONTEND_URL=https://landline.apprendtechnologies.com
# Fernet key used to encrypt stored OAuth tokens at rest. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Claude API (scoring + email generation) ----
ANTHROPIC_API_KEY=

# ---- Apollo.io (contact enrichment) ----
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io/v1

# ---- Census Bureau (market data) ----
CENSUS_API_KEY=

# ---- Auth / security ----
# REQUIRED. Secret used to sign JWT access/refresh tokens. The app refuses to
# boot without one (no insecure default). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Optional shared API key. When set, requests may authenticate with the
# X-API-Key header instead of a JWT. Auth is mandatory either way.
API_KEY=
# Optional Redis URI for shared rate-limit counters across workers
# (defaults to in-process memory). e.g. redis://localhost:6379/2
RATELIMIT_STORAGE_URI=

# ---- App ----
APP_NAME=Landline
# Set to "production" to disable interactive /docs, /redoc, and /openapi.json.
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ---- CORS ----
# JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---- Sending safety: kill switch + warm-up ----
# Default kill-switch state when it has never been explicitly set. Set to false
# in production so a fresh install stays PAUSED until an operator turns sending on.
SENDING_ENABLED_DEFAULT=false
# Warm-up ramp: conservative 20 → 50 → 100 emails/day over the first 3 weeks,
# then steady at MAX_EMAILS_PER_DAY. Reset WARMUP_START_DATE to go-live (the
# persisted system_settings value, set on first send or from the UI, wins).
WARMUP_ENABLED=true
WARMUP_START_DATE=2026-07-15
WARMUP_DAILY_LIMIT_WEEK1=20
WARMUP_DAILY_LIMIT_WEEK2=50
WARMUP_DAILY_LIMIT_WEEK3=100
MAX_EMAILS_PER_DAY=100
MIN_DAYS_BETWEEN_FOLLOWUPS=3
MAX_EMAILS_PER_CONTACT_PER_MONTH=8
