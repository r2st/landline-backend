# Landline Backend — Environment Variables
# Copy to .env (development) or .env.production (staging/prod)

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://landline:CHANGE_ME@localhost:5432/landline_db
POSTGRES_USER=landline
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=landline_db

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- AWS (SES for transactional email) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_SENDER_EMAIL=landline@apprendtechnologies.com

# ---- Claude API (scoring + email generation) ----
ANTHROPIC_API_KEY=

# ---- Apollo.io (contact enrichment) ----
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io/v1

# ---- Census Bureau (market data) ----
CENSUS_API_KEY=

# ---- App ----
APP_NAME=Landline
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ---- CORS ----
# JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
